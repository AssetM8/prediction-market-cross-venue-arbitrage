# Copy to backend/.env (the API and CLI read .env from their working directory) or export
# the variables. Nothing here is required: every default works offline with fixtures.
# No trading credentials exist in this project. Do not add any.

# --- application ------------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./arbitrage.db
# PostgreSQL (install with: cd backend && uv sync --extra postgres)
# DATABASE_URL=postgresql+asyncpg://arb:arb@127.0.0.1:5432/arb

# Must stay true. Setting false fails validation at startup: no live execution path exists.
PAPER_TRADING_ONLY=true

# fixture = checked-in synthetic data + simulated clock (offline, deterministic)
# live    = public read-only venue APIs (used by the API refresh endpoint; the CLI
#           `scan --live` / `make live-scan` forces live regardless of this value)
DATA_MODE=fixture
AUTO_SCAN_ON_STARTUP=true
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- venue endpoints (read-only, public) -------------------------------------------------
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Also documented: https://api.elections.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_WS_ENABLED=true

# --- HTTP behaviour ------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=8
KALSHI_MAX_REQUESTS_PER_SECOND=8
POLYMARKET_MAX_REQUESTS_PER_SECOND=10

# --- live scan bounds -----------------------------------------------------------------------
LIVE_MAX_PAGES_KALSHI=10
LIVE_MAX_PAGES_POLYMARKET=20
LIVE_MAX_BOOK_CANDIDATES=40
# 0 = full depth (Kalshi orderbook depth parameter)
BOOK_DEPTH_LEVELS=0
POLL_INTERVAL_SECONDS=5

# --- matching -------------------------------------------------------------------------------
MARKET_PAIR_MIN_CONFIDENCE=0.90
CANDIDATE_MIN_SIMILARITY=0.30
CANDIDATE_TIME_WINDOW_DAYS=400
# maximum difference between expected resolution times for an equivalence (hours)
MAX_CLOSE_TIME_DIFF_HOURS=72
MAX_CANDIDATES_PER_MARKET=25

# --- arbitrage thresholds and buffers (collateral dollars; per contract unless noted) ---
BOOK_STALE_AFTER_SECONDS=30
MIN_NET_PROFIT=1.00
MIN_RETURN_ON_CAPITAL=0.005
SETTLEMENT_COST_BUFFER=0.0050
LATENCY_RISK_BUFFER=0.0025
# annual cost of capital locked until resolution
CAPITAL_COST_ANNUAL_RATE=0.05
MIN_TOP_OF_BOOK_DEPTH=1
QUANTITY_STEP=1
MAX_TRADE_QUANTITY=5000

# --- fees (documented formulas; fallbacks are used only when metadata is missing) -------
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_FEE_ROUNDING_QUANTUM=0.0001
KALSHI_FALLBACK_FEE_MULTIPLIER=2
POLYMARKET_FALLBACK_FEE_RATE=0.07
POLYMARKET_FEE_ROUNDING_QUANTUM=0.00001

# --- paper execution ------------------------------------------------------------------------
# sequential (leg 1 then leg 2) | simultaneous_ioc
EXECUTION_POLICY=sequential
MAX_UNHEDGED_NOTIONAL=25
MAX_HEDGE_SLIPPAGE=0.02
UNWIND_HAIRCUT=0.01
KILL_SWITCH_MAX_CONSECUTIVE_FAILURES=3
PARTIAL_FILL_FRACTION=0.4
ADVERSE_PRICE_MOVE=0.03
PAPER_STARTING_CASH_KALSHI=10000
PAPER_STARTING_CASH_POLYMARKET=10000

# --- optional semantic components ------------------------------------------------------------
# hashing = local deterministic character-trigram embedding (no download); none = off
OPTIONAL_EMBEDDINGS=hashing
# none | anthropic. The LLM can only veto an approval; it never approves anything.
OPTIONAL_LLM_PROVIDER=none
OPTIONAL_LLM_MODEL=
OPTIONAL_LLM_API_KEY=
OPTIONAL_LLM_BASE_URL=https://api.anthropic.com
OPTIONAL_LLM_TIMEOUT_SECONDS=30
